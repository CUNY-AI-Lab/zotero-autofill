{
  "name": "zotero-metadata-assistant",
  "type": "module",
  "version": "1.1.0",
  "description": "A CUNY AI Lab tool for reviewing scholarly metadata and importing bibliographies",
  "config": {
    "addonName": "Zotero Metadata Assistant",
    "addonID": "zotero-metadata-assistant@smorello.org",
    "addonRef": "zotero-metadata-assistant",
    "addonInstance": "ZoteroMetadataAssistant",
    "prefsPrefix": "extensions.zotero.metadata-assistant"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CUNY-AI-Lab/zotero-autofill.git"
  },
  "author": "Stefano Morello",
  "bugs": {
    "url": "https://github.com/CUNY-AI-Lab/zotero-autofill/issues"
  },
  "homepage": "https://github.com/CUNY-AI-Lab/zotero-autofill#readme",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit && npm run check:bundle",
    "check:bundle": "! grep -rlE 'zotero://(plugin|ztoolkit-debug)' .scaffold/build/addon",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save",
    "test:unit": "node --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "5.1.0-beta.4"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.3.0",
    "eslint": "^10.12.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
